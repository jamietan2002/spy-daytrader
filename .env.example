# Alpaca Paper Trading Credentials (REQUIRED — Paper Trading Only)
# Tip: Use a dedicated Alpaca Paper sub-account key so intraday margin & EOD flatten stay 100% isolated.
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market Data Feed: "iex" (free on all Paper accounts) or "sip" (paid real-time SIP)
ALPACA_DATA_FEED=iex

# Strategy Mode: "alpha_max" (v2 Session-Regime Long+Short + Limit Collar) or "baseline" (Strict Prompt Spec)
STRATEGY_MODE=alpha_max
# ATR Profile: "standard" (1.5x SL / 2.25x TP = 1.5R) or "wide" (2.0x SL / 3.0x TP = 1.5R)
ATR_PROFILE=standard
# Instrument: SPY default; also supports QQQ, TQQQ, NVDA, IWM to unlock full 1% risk deployment
TRADING_SYMBOL=SPY

# Crash-Safe Local SQLite State Ledger
STATE_DB_PATH=data/bot_state.db

# Polling & Bar Warmup
POLL_INTERVAL_SECONDS=60
BARS_TO_FETCH=650

# Risk & Bracket Parameters
RISK_PER_TRADE_PCT=0.01
DAILY_MAX_DRAWDOWN_PCT=0.025
BUYING_POWER_SAFETY_BUFFER=0.95
MAX_NOTIONAL_EQUITY_MULT=3.80

# Logging
LOG_LEVEL=INFO
